# 网页/API
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_TIMEOUT_SECONDS=3600
# 最多允许 16 个排队/运行中的任务；终态任务默认保留 6 小时
MAX_QUEUE_SIZE=16
JOB_TTL_SECONDS=21600
JOB_CLEANUP_INTERVAL_SECONDS=300
# 非本机访问视频 API 时必须设置，并在调用端提供同一个 Token
VIDEO_API_TOKEN=
# B 站：留空沿用 yutto 配置，网络错误后自动直连重试一次；auto 同样允许重试。
# no 强制直连；也可指定 http(s)/socks5 代理地址，明确指定时不自动切换路线。
BILIBILI_PROXY=
# X 公开视频默认不需要 Cookie；受限推文二选一配置，平时保持为空
X_COOKIES_FILE=
X_COOKIES_FROM_BROWSER=
DOUYIN_COOKIES_FILE=
DOUYIN_COOKIES_FROM_BROWSER=
XIAOHONGSHU_COOKIES_FILE=
XIAOHONGSHU_COOKIES_FROM_BROWSER=
# 小黑盒默认匿名；要求登录时可配置 Netscape Cookie。验证码仍需在浏览器手动完成。
XIAOHEIHE_COOKIES_FILE=
DOUYIN_F2_PYTHON=

# QQ 机器人监听地址（NapCat 反向 WebSocket 连接到这里）
QQ_BOT_HOST=127.0.0.1
QQ_BOT_PORT=8081

# 机器人访问 API 的地址，以及 NapCat 获取 MP4 时可访问的地址
BILI_API_URL=http://127.0.0.1:8000
BILI_PUBLIC_API_URL=http://127.0.0.1:8000

# 强烈建议填写，只监听指定群；多个群号用英文逗号分隔。留空表示所有群。
QQ_ALLOWED_GROUPS=123456789
QQ_MAX_VIDEO_MB=100
QQ_JOB_TIMEOUT=3600
QQ_POLL_INTERVAL=2
QQ_ANNOUNCE_START=true
# 视频发送后等待 NapCat 拉取文件的时间；清理失败会按此间隔重试
QQ_VIDEO_CLEANUP_DELAY_SECONDS=180
QQ_VIDEO_CLEANUP_RETRY_SECONDS=30

# NapCat Shell 启动器；start-all.cmd 会读取此路径
NAPCAT_LAUNCHER=..\NapCat.Shell\launcher-win10.bat
# 可选：快速登录账号；留空则由 NapCat 显示登录界面/二维码
NAPCAT_QQ=

# Switch 好友码监控
SWITCH_POLL_INTERVAL=60
SWITCH_NXAPI_TIMEOUT=90

# PS5/PSN 视奸；凭据通过 ps5-login.cmd 写入 secrets，不要直接填在这里
PSN_NPSSO_FILE=./secrets/psn-npsso.txt
PS5_POLL_INTERVAL=90
# 奖杯本地库；正常每天北京时间 04:10、16:10 检查，首次与失败恢复分批进行
PS_TROPHY_DB_PATH=./data/ps-trophies.db

# Steam 视奸；运行 steam-login.cmd 后 API Key 会写入 secrets
STEAM_API_KEY_FILE=./secrets/steam-api-key.txt
# 可选：Steam 官方没有竖版封面时，从 SteamGridDB 获取 600x900 封面
STEAMGRIDDB_API_KEY_FILE=./secrets/steamgriddb-api-key.txt
STEAM_POLL_INTERVAL=90
# 可选：Steam Web API 显式 HTTP 代理；留空沿用自动线路。按本机代理端口填写。
STEAM_HTTP_PROXY=
# 进程内 Steam 游戏资料缓存上限
STEAM_RUNTIME_CACHE_MAX_ITEMS=512

# Xbox 视奸；通过管理后台“打开 Xbox 登录”完成微软账号登录
XBOX_TOKENS_FILE=./secrets/xbox-tokens.json
# 可选备用通道；微软直连正常时不需要 OpenXBL
OPENXBL_API_KEY_FILE=./secrets/openxbl-api-key.txt
XBOX_POLL_INTERVAL=90
# 登记超过 50 人时，分批查询之间稍作等待以降低 429 风险
XBOX_BATCH_DELAY_SECONDS=0.25

# 今日游戏时长排行榜；超过此秒数的轮询空档不累计，避免断线虚增
GAME_TIME_MAX_SAMPLE_GAP=300
# 游戏发售提醒：每天此小时后提醒；1,0 表示明日和今日
GAME_RELEASE_REMINDER_HOUR=9
GAME_RELEASE_REMINDER_DAYS=1,0
GAME_RELEASE_REMINDER_INTERVAL=300
# 任天堂商店目录刷新间隔（秒），以及卡片头像/封面缓存限制
NINTENDO_CATALOG_CACHE_TTL=21600
LIST_IMAGE_CACHE_MAX_FILES=512
LIST_IMAGE_CACHE_MAX_AGE_DAYS=30
BOT_HEALTH_INTERVAL=30
# QQ Bot 每隔几秒写入一次应用层 OneBot 心跳，供外部看门狗判断真实连接状态
BOT_HEARTBEAT_INTERVAL=5

# DSH 私聊助手：白名单私聊可写工作区；群聊和自动任务使用独立只读实例
# 需要先安装 dsh CLI 并建好 %USERPROFILE%\.dsh-qq\profiles\qq，见 docs/DSH私聊助手.md
QQ_DSH_ENABLED=false
# 主人私聊权限：workspace-write（默认）或 read-only；不自动批准额外权限
QQ_DSH_PERMISSION_MODE=workspace-write
# 安装浏览器插件后向主人私聊提供浏览器操作；false 可关闭
QQ_DSH_BROWSER_ENABLED=true
# 私聊用户白名单，逗号分隔；群聊开关和群白名单见下方
QQ_DSH_USERS=
QQ_DSH_TIMEOUT=600
# 闲置多久后关掉 dsh 子进程（秒）；记忆保存在磁盘，下次发消息自动恢复
QQ_DSH_IDLE_SECONDS=0
# 回答字数上限；超过时在句子末尾截断，避免长篇大论
QQ_DSH_MAX_ANSWER_CHARS=700
# 单条消息最多几张图交给模型看；0 关闭识图
QQ_DSH_MAX_IMAGES=4
# 短句里逗号/句号分隔时拆成多条消息的字符阈值（超过就保持一条）
QQ_DSH_BUBBLE_COMMA_CHARS=30
# 回复最多拆几条；0 = 不限（硬上限 30）
QQ_DSH_MAX_BUBBLES=0
# 多条气泡之间的间隔（秒）
QQ_DSH_BUBBLE_DELAY_SECONDS=0.6
QQ_DSH_HOME=~/.dsh-qq
QQ_DSH_PROFILE=qq
# dsh 启动器入口；留空时按 QQ_DSH_HOME 推导 node_modules 路径
QQ_DSH_CLI=
QQ_DSH_WORKDIR=
# 模型 API key；与 dsh 共用同一个变量名
DEEPSEEK_API_KEY=

# 群里的视频链接发不出来时自动补发（失败后让只读 DSH 排查并私聊主人）
QQ_REPAIR_ENABLED=true
# 重试间隔（秒），逗号分隔
QQ_REPAIR_DELAYS=45,180,600
# 补发前先发的一句话；留空则直接发内容、不加提示
QQ_REPAIR_NOTE=
# 全部重试失败后自动排查
QQ_REPAIR_DIAG=true
# 群内问答：只有 @ 机器人且后面跟具体问题才回，其余一律不回复
QQ_DSH_GROUP_ENABLED=true
# 允许群内问答的群号；留空则沿用 QQ_ALLOWED_GROUPS
QQ_DSH_GROUPS=
# 群里提到的主人网名
QQ_DSH_OWNER_NAME=管理员
# 群里手打 @ 机器人时用的昵称（可逗号分隔多个）
QQ_DSH_BOT_ALIAS=
# 说话风格学习（采样 → 周期总结 → 达标后自动停止）
QQ_STYLE_ENABLED=true
QQ_STYLE_MIN_SAMPLES=60
QQ_STYLE_MAX_ROUNDS=2
QQ_STYLE_INTERVAL_HOURS=24
QQ_STYLE_MAX_SAMPLES=600
